<mxCell id="18" value="GHI CHÚ: Project hiện tại là Spring Boot monolith, không phải microservices. Chức năng call nhóm chưa hoàn thiện, báo cáo chỉ trình bày call signal demo 1-1 và đưa gọi nhóm vào hướng phát triển." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d97706;fontSize=13;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="1700" height="70" as="geometry"/></mxCell>
