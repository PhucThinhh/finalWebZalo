        <mxCell id="legend" value="&lt;b&gt;Ghi chú chèn báo cáo:&lt;/b&gt; thay sơ đồ ERD cũ tại mục &lt;b&gt;3.7 Thiết kế dữ liệu&lt;/b&gt;. Sơ đồ này đã bỏ ModerationLog/Toxic SafeChat và CallHistory vì project hiện tại không có entity đó; đồng thời bổ sung Poll, MessageReaction, ConversationBackground, ConversationNickname." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=8;" parent="1" vertex="1"><mxGeometry x="170" y="1320" width="2080" height="80" as="geometry"/></mxCell>
