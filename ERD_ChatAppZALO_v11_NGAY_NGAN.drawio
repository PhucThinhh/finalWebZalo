        <mxCell id="title" value="ERD THIẾT KẾ DỮ LIỆU - CHATAPPZALO" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry x="500" y="25" width="1600" height="42" as="geometry"/></mxCell>
        <mxCell id="note_top" value="Sơ đồ được vẽ theo project hiện tại: Spring Boot + MySQL + MongoDB. Call nhóm chưa hoàn thiện nên không đưa CallHistory vào ERD." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=8;" parent="1" vertex="1"><mxGeometry x="620" y="75" width="1380" height="54" as="geometry"/></mxCell>
