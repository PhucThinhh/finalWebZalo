        <mxCell id="User" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;User&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MySQL table&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK id: Long&lt;br&gt;username, password&lt;br&gt;email, phone&lt;br&gt;gender, birthday&lt;br&gt;avatar, coverImage&lt;br&gt;role: USER/ADMIN&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu tài khoản, hồ sơ và phân quyền.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#5b9bd5;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="120" y="230" width="310" height="300" as="geometry"/></mxCell>
        <mxCell id="Otp" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Otp&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MySQL table&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK id: Long&lt;br&gt;email&lt;br&gt;code&lt;br&gt;expiredAt&lt;br&gt;used&lt;br&gt;verified&lt;br&gt;createdAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu OTP đăng ký và quên mật khẩu.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#5b9bd5;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="470" y="230" width="310" height="255" as="geometry"/></mxCell>
        <mxCell id="Friendship" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Friendship&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MySQL table&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK id: Long&lt;br&gt;senderId → User.id&lt;br&gt;receiverId → User.id&lt;br&gt;status: PENDING/ACCEPTED&lt;br&gt;createdAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Quản lý lời mời và quan hệ bạn bè.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#5b9bd5;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="120" y="610" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="BlockedUser" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;BlockedUser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MySQL table&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK id: Long&lt;br&gt;userId → User.id&lt;br&gt;blockedUserId → User.id&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Quản lý quan hệ chặn người dùng.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#5b9bd5;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="470" y="610" width="310" height="210" as="geometry"/></mxCell>
        <mxCell id="ConversationBackground" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ConversationBackground&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MySQL table&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK id: Long&lt;br&gt;roomId&lt;br&gt;background&lt;br&gt;updatedBy → User.id&lt;br&gt;updatedAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu ảnh/nền cuộc trò chuyện.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#5b9bd5;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="120" y="930" width="660" height="210" as="geometry"/></mxCell>
        <mxCell id="Group" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Group&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: chat_group&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;name&lt;br&gt;createdBy → User.id&lt;br&gt;createdAt&lt;br&gt;avatar&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu thông tin nhóm chat.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="960" y="230" width="310" height="240" as="geometry"/></mxCell>
        <mxCell id="GroupMember" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;GroupMember&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: group_member&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;groupId → Group._id&lt;br&gt;userId → User.id&lt;br&gt;role: OWNER/ADMIN/MEMBER&lt;br&gt;removed, removedAt, removedBy&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu thành viên và vai trò trong nhóm.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="960" y="570" width="310" height="270" as="geometry"/></mxCell>
        <mxCell id="Message" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Message&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: messages&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;senderId → User.id&lt;br&gt;receiverId → User.id&lt;br&gt;roomId&lt;br&gt;content, type, fileUrl&lt;br&gt;isDeleted, isRecalled&lt;br&gt;originalMessageId&lt;br&gt;pollId → Poll._id&lt;br&gt;pinned, pinnedBy, pinnedAt&lt;br&gt;createdAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu tin nhắn cá nhân/nhóm, file và poll message.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1350" y="230" width="360" height="420" as="geometry"/></mxCell>
        <mxCell id="MessageReaction" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;MessageReaction&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: message_reactions&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;messageId → Message._id&lt;br&gt;roomId&lt;br&gt;userId → User.id&lt;br&gt;emoji&lt;br&gt;createdAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu cảm xúc từng user thả vào tin nhắn.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1800" y="230" width="330" height="245" as="geometry"/></mxCell>
        <mxCell id="Poll" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Poll&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: polls&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;roomId&lt;br&gt;question&lt;br&gt;createdBy → User.id&lt;br&gt;createdAt, expiresAt&lt;br&gt;closed&lt;br&gt;multipleChoice&lt;br&gt;allowAddOption&lt;br&gt;anonymous&lt;br&gt;hideResultUntilVoted&lt;br&gt;pinned&lt;br&gt;options: List&lt;PollOption&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu bình chọn trong nhóm chat.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1350" y="740" width="360" height="340" as="geometry"/></mxCell>
        <mxCell id="PollOption" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;PollOption&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Embedded document&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;id: String&lt;br&gt;text&lt;br&gt;createdBy → User.id&lt;br&gt;createdAt&lt;br&gt;voters: List&lt;User.id&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Option nằm bên trong Poll, không phải collection riêng.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f9fff9;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1800" y="740" width="330" height="240" as="geometry"/></mxCell>
        <mxCell id="ConversationState" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ConversationState&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: conversation_state&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;conversationKey&lt;br&gt;userId → User.id&lt;br&gt;isDeleted&lt;br&gt;deletedAt&lt;br&gt;lastReadAt&lt;br&gt;background&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu trạng thái xóa/ẩn/đọc hội thoại theo user.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="960" y="930" width="310" height="270" as="geometry"/></mxCell>
        <mxCell id="ConversationNickname" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ConversationNickname&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;MongoDB collection: conversation_nicknames&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;PK _id: String&lt;br&gt;conversationKey&lt;br&gt;ownerUserId → User.id&lt;br&gt;targetUserId → User.id&lt;br&gt;nickname&lt;br&gt;updatedAt&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Lưu biệt danh theo từng cuộc trò chuyện.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=2;shadow=0;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1350" y="1160" width="360" height="250" as="geometry"/></mxCell>
